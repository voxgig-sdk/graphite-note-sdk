# Entity: model_info

main: kit: entity: model_info: {

  alias: field: {}

  fields: [
    {
      name: "code"
      req: false
      short: "Model code (Settings tab, ID section)."
      type: "`$STRING`"
    }
    {
      name: "created_at"
      req: false
      type: "`$STRING`"
    }
    {
      name: "dataset_code"
      req: false
      short: "Code of the dataset the model is trained on."
      type: "`$STRING`"
    }
    {
      name: "model_name"
      req: false
      short: "Model type name, e.g."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "User-given model name."
      type: "`$STRING`"
    }
    {
      name: "properties"
      req: false
      short: "Full model configuration and structured metadata (excluding bulky training artifacts); shape differs by model type (RFM, CLV, ABC, ...)."
      type: "`$OBJECT`"
    }
    {
      name: "updated_at"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "model_info"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "model_code"
                orig: "model_code"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/model/fetch-model-info/{model_code}"
          parts: [
            "model"
            "fetch-model-info"
            "{model_code}"
          ]
          select: {
            exist: [
              "model_code"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "fetch_model_info"
      ]
    ]
  }



}
