# Entity: dataset

main: kit: entity: dataset: {

  alias: field: {}

  fields: [
    {
      name: "column"
      op: {
        create: {
          req: true
          type: "`$ARRAY`"
        }
      }
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "dataset_code"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      type: "`$STRING`"
    }
    {
      name: "table_name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "user_code"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "dataset"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/dataset-create"
          parts: [
            "dataset-create"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
