# Entity: dataset_fill

main: kit: entity: dataset_fill: {

  alias: field: {}

  fields: [
    {
      name: "append"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "columns"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "compressed"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "datasetcode"
      req: true
      type: "`$STRING`"
    }
    {
      name: "details"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "insertdata"
      req: true
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      type: "`$STRING`"
    }
    {
      name: "usercode"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "dataset_fill"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/dataset-complete"
          parts: [
            "dataset-complete"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          method: "POST"
          orig: "/dataset-fill"
          parts: [
            "dataset-fill"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
