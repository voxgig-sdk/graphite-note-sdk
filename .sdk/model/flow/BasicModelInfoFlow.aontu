  name: "BasicModelInfoFlow",
  step: [
    {
      i: {
        ref: "model_info_ref01",
        srcdatavar: "model_info_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "model_info01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-model_info_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicModelInfoFlow"
}